program     ::= { struct } { fn } { statement } exit
struct      ::= "struct" ident NL "{" NL field_decl { field_decl } { fn } "}" NL
field_decl  ::= type [ "mut" ] ident NL
fn          ::= "fn" ident ":=" "(" [ type ident { "," type ident } ] ")" "->" type NL block
statement   ::= decl | assign | if | while | print
decl        ::= type [ "mut" ] ident "{" init { "," init } "}"
init        ::= expr | "{" init { "," init } "}"
assign      ::= ident { "." ident } ":=" expr
if          ::= "if" expr NL block [ "else" NL block ]
while       ::= "while" expr NL block
print       ::= "print" "(" ( string | expr ) ")"
block       ::= "{" NL [ { statement } exit NL ] "}" NL
expr        ::= arith [ ( "==" | "!=" ) arith ]
arith       ::= term { ( "+" | "-" ) term }
term        ::= factor { "*" factor }
factor      ::= number | "true" | "false" | ident | field | call | member_call | read | call_chain
              | "!" factor
field       ::= ident "." ident { "." ident }
args        ::= "(" [ expr { "," expr } ] ")"
call        ::= ident args
member_call ::= ident { "." ident } "." ident args
read        ::= "read" "(" ")"
call_chain  ::= ( call | member_call | read ) "." ident { "." ident } [ args ] { "." ident { "." ident } [ args ] }
exit        ::= "exit" factor
type        ::= "i32" | "i64" | "bool" | ident
string      ::= '"' { any byte except '"' and newline } '"'

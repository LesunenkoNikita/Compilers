Program
  Lambda counter -> i32
    Param start i32
    Block
      Exit
        Var start
  Decl n i32 const
    Call counter
      Const 0
  Lambda next -> i32
    Capture mut n
    Block
      Assign n
        BinOp +
          Var n
          Const 1
      Exit
        Var n
  Print
    Call next
  Print
    Call next
  Print
    Call next
  Exit
    Var n

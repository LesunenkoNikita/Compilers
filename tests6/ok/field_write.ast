Program
  Struct Point
    FieldDecl x i32 mut
    FieldDecl y i32 mut
  Struct Circle
    FieldDecl center Point const
    FieldDecl radius i32 mut
  Decl p Point const
    Const 10
    Const 20
  Decl c Circle mut
    Var p
    Const 10
  Assign c.radius
    Const 5
  Decl q Point mut
    Var p
  Assign q.x
    BinOp +
      Field q.x
      Field c.radius
  Exit
    Field q.x

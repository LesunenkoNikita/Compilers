Program
  Struct Point
    FieldDecl x i32 mut
    FieldDecl y i32 mut
  Struct Circle
    FieldDecl center Point const
    FieldDecl radius i32 mut
  Fn origin -> Point
    Block
      Decl o Point const
        Const 0
        Const 0
      Exit
        Var o
  Decl p Point const
    Const 3
    Const 4
  Decl a Circle const
    InitList
      Var p
    Const 1
  Decl b Circle const
    Call origin
    Const 2
  Decl c Circle const
    InitList
      Field a.center.y
      Field b.radius
    Const 9
  Decl result i32 const
    BinOp +
      BinOp +
        Field c.center.x
        Field c.center.y
      Field a.center.x
  Exit
    Var result
